{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SYNTAX_HIGHLIGHT": "true",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true"
  },
  "permissions": {
    "allow": [
      "mcp__gopls__*",
      "Skill(pr-review-toolkit:review-pr)",
      "Skill(update-config)",
      "Bash(bash -c 'GO_VER=$\\(grep -rh \"^go \" --include=\"go.mod\" . 2>/dev/null | cut -d'\\\\'' '\\\\'' -f2 | sort | uniq -c | sort -nr | head -1 | xargs | cut -d'\\\\'' '\\\\'' -f2 | grep .\\); [ -z \"$GO_VER\" ] && exit 0; printf '\\\\''{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"This project uses Go %s. Apply all modern Go guidelines and language features up to and including Go %s. Prefer slices/maps/cmp packages, use modern built-ins \\(min, max, clear\\), and never use outdated patterns when a modern alternative exists.\"}}\\\\n'\\\\'' \"$GO_VER\" \"$GO_VER\"')",
      "Bash(git -C .claude/worktrees/* diff main --stat)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(gopls *)",
      "Bash(grep *)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(make build-data)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make test-only)",
      "Bash(make test-only-integration)",
      "Bash(make vuln-check)",
      "Bash(staticcheck *)",
      "Bash(xargs -I{} sh -c 'echo \"=== {} ===\"; cat {}')",
      "Bash(xargs ls -la)",
      "Bash(xargs ls -lh)",
      "Read(//private/tmp/**)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "Bash(echo \"EXIT:$?\")",
      "Bash(claude mcp *)",
      "Bash(make test *)",
      "Bash(make -n *)",
      "Bash(git -C * rev-parse --show-toplevel)",
      "Bash(git --no-pager diff HEAD -- *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.aws/**)",
      "Read(~/config/aws/**)",
      "Read(~/azure/**)",
      "Read(~/config/azure/**)",
      "Read(~/kube/**)",
      "Read(~/config/kube/**)",
      "Read(**/.gcloud/**)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(.git-credentials)",
      "Read(.netrc)",
      "Read(**/*password*)",
      "Read(**/*.token)",
      "Read(**/*token*.json)",
      "Read(**/*token*.txt)",
      "Read(**/*token*.env)",
      "Read(**/*token*.yaml)",
      "Read(**/*token*.yml)",
      "Read(**/*secret*)",
      "Edit(~/.claude/settings.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git merge:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)"
    ]
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "gopls"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GO_VER=$(grep -rh \"^go \" --include=\"go.mod\" . 2>/dev/null | cut -d' ' -f2 | sort | uniq -c | sort -nr | head -1 | xargs | cut -d' ' -f2 | grep .); [ -z \"$GO_VER\" ] && exit 0; printf '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"This project uses Go %s. Apply all modern Go guidelines and language features up to and including Go %s. Prefer slices/maps/cmp packages, use modern built-ins (min, max, clear), and never use outdated patterns when a modern alternative exists.\"}}\n' \"$GO_VER\" \"$GO_VER\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "effortLevel": "low",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
